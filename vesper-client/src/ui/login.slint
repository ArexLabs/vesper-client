import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";

export component LoginPage inherits VerticalBox {
    in property <bool> is-logged-in: false;
    in property <string> username: "";
    in property <bool> is-polling: false;
    in property <string> auth-error: "";

    callback login-requested();
    callback logout-requested();

    if !is-logged-in : VerticalBox {
        alignment: center;
        spacing: 16px;

        Rectangle {
            background: #1e1e2e;
            border-radius: 12px;
            vertical-stretch: 0;
            HorizontalBox {
                alignment: center;
                VerticalBox {
                    alignment: center;
                    spacing: 12px;
                    padding: 32px;
                    Text {
                        text: "Vesper Client";
                        font-size: 28px;
                        color: #cdd6f4;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Sign in with your Microsoft account";
                        font-size: 14px;
                        color: #a6adc8;
                        horizontal-alignment: center;
                    }
                    if !is-polling : Button {
                        text: "Sign in with Microsoft";
                        clicked => { root.login-requested(); }
                    }
                    if is-polling : VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "Waiting for browser authentication...";
                            font-size: 14px;
                            color: #a6adc8;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Sign in using the browser window that opened, then return here.";
                            font-size: 12px;
                            color: #6c7086;
                            horizontal-alignment: center;
                        }
                    }
                    if root.auth-error != "" : Text {
                        text: root.auth-error;
                        font-size: 13px;
                        color: #f38ba8;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if is-logged-in : VerticalBox {
        alignment: center;
        spacing: 16px;

        Rectangle {
            background: #1e1e2e;
            border-radius: 12px;
            vertical-stretch: 0;
            HorizontalBox {
                alignment: center;
                VerticalBox {
                    alignment: center;
                    spacing: 12px;
                    padding: 32px;
                    Text {
                        text: "Welcome back!";
                        font-size: 24px;
                        color: #cdd6f4;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.username;
                        font-size: 18px;
                        color: #a6e3a1;
                        horizontal-alignment: center;
                    }
                    Button {
                        text: "Sign Out";
                        clicked => { root.logout-requested(); }
                    }
                }
            }
        }
    }
}
