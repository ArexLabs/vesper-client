import { VerticalBox, HorizontalBox, Button, LineEdit, ComboBox, ListView } from "std-widgets.slint";
import { InstanceEntry } from "types.slint";

component CreateInstanceForm inherits VerticalBox {
    in-out property <string> inst-name: "";
    in-out property <string> mc-version: "1.21.1";
    in-out property <string> loader: "Vanilla";
    in-out property <string> loader-version: "";

    callback create-requested(name: string, mc-version: string, loader: string, loader-version: string);

    Rectangle {
        background: #1e1e2e;
        border-radius: 8px;

        VerticalBox {
            padding: 20px;
            spacing: 12px;
            Text {
                text: "Create New Instance";
                font-size: 18px;
                font-weight: 700;
                color: #cdd6f4;
            }
            HorizontalBox {
                spacing: 8px;
                Text { text: "Name:"; color: #a6adc8; vertical-alignment: center; width: 80px; }
                LineEdit {
                    text: root.inst-name;
                    placeholder-text: "My Instance";
                    edited(t) => { root.inst-name = t; }
                }
            }
            HorizontalBox {
                spacing: 8px;
                Text { text: "MC Version:"; color: #a6adc8; vertical-alignment: center; width: 80px; }
                ComboBox {
                    model: ["1.21.1", "1.21", "1.20.6", "1.20.4", "1.20.1", "1.19.4", "1.18.2"];
                    current-value: root.mc-version;
                    selected(v) => { root.mc-version = v; }
                }
            }
            HorizontalBox {
                spacing: 8px;
                Text { text: "Loader:"; color: #a6adc8; vertical-alignment: center; width: 80px; }
                ComboBox {
                    model: ["Vanilla", "Fabric", "NeoForge"];
                    current-value: root.loader;
                    selected(v) => { root.loader = v; }
                }
            }
            HorizontalBox {
                spacing: 8px;
                Text { text: "Loader Ver:"; color: #a6adc8; vertical-alignment: center; width: 80px; }
                LineEdit {
                    text: root.loader-version;
                    placeholder-text: "Latest Stable";
                    edited(t) => { root.loader-version = t; }
                }
            }
            Button {
                text: "Create";
                enabled: root.inst-name != "";
                clicked => {
                    root.create-requested(root.inst-name, root.mc-version, root.loader, root.loader-version);
                }
            }
        }
    }
}

export component InstancesPage inherits VerticalBox {
    in property <[InstanceEntry]> instances: [];
    in property <bool> show-create-form: false;

    callback create-requested(name: string, mc-version: string, loader: string, loader-version: string);
    callback delete-requested(id: string);
    callback launch-requested(id: string);
    callback toggle-create-form();

    Rectangle {
        background: #181825;
        border-radius: 8px;
        vertical-stretch: 1;

        VerticalBox {
            padding: 16px;
            spacing: 16px;

            HorizontalBox {
                Text {
                    text: "Instances";
                    font-size: 22px;
                    font-weight: 700;
                    color: #cdd6f4;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.show-create-form ? "Cancel" : "+ New Instance";
                    clicked => { root.toggle-create-form(); }
                }
            }

            if root.show-create-form : CreateInstanceForm {
                create-requested(name, mc-version, loader, loader-version) => {
                    root.create-requested(name, mc-version, loader, loader-version);
                    root.toggle-create-form();
                }
            }

            if root.instances.length == 0 && !root.show-create-form : VerticalBox {
                alignment: center;
                Text {
                    text: "No instances yet.\nCreate your first one!";
                    font-size: 16px;
                    color: #6c7086;
                    horizontal-alignment: center;
                }
            }

            ListView {
                for inst in root.instances : Rectangle {
                    background: #1e1e2e;
                    border-radius: 8px;
                    height: 72px;

                    HorizontalBox {
                        padding: 12px;
                        spacing: 12px;

                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: inst.name;
                                font-size: 16px;
                                font-weight: 700;
                                color: #cdd6f4;
                            }
                            HorizontalBox {
                                spacing: 8px;
                                Rectangle {
                                    background: #313244;
                                    border-radius: 4px;
                                    height: 20px;
                                    HorizontalBox {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "MC " + inst.mc-version;
                                            font-size: 11px;
                                            color: #89b4fa;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    background: #313244;
                                    border-radius: 4px;
                                    height: 20px;
                                    HorizontalBox {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: inst.loader;
                                            font-size: 11px;
                                            color: #a6e3a1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Button {
                            text: "Play";
                            clicked => { root.launch-requested(inst.id); }
                        }
                        Button {
                            text: "Delete";
                            clicked => { root.delete-requested(inst.id); }
                        }
                    }
                }
            }
        }
    }
}
