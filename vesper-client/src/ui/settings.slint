import { VerticalBox, HorizontalBox, Button, LineEdit } from "std-widgets.slint";

export component SettingsPage inherits VerticalBox {
    in-out property <string> java-path: "";
    in property <int> max-memory: 4096;
    in-out property <string> jvm-args: "";

    callback save-requested(java-path: string, max-memory: int, jvm-args: string, window-width: int, window-height: int);
    callback detect-java();

    Rectangle {
        background: #181825;
        border-radius: 8px;
        vertical-stretch: 1;

        VerticalBox {
            padding: 20px;
            spacing: 16px;

            Text {
                text: "Settings";
                font-size: 22px;
                font-weight: 700;
                color: #cdd6f4;
            }

            Text {
                text: "Java Configuration";
                font-size: 16px;
                font-weight: 700;
                color: #a6adc8;
            }

            VerticalBox {
                spacing: 10px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Java Path:"; color: #a6adc8; vertical-alignment: center; width: 120px; }
                    LineEdit {
                        text: root.java-path;
                        placeholder-text: "Auto-detect (java)";
                        edited(t) => { root.java-path = t; }
                    }
                    Button {
                        text: "Detect";
                        clicked => { root.detect-java(); }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "Max Memory:"; color: #a6adc8; vertical-alignment: center; width: 120px; }
                    Text { text: root.max-memory + " MB"; color: #cdd6f4; vertical-alignment: center; width: 100px; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "JVM Args:"; color: #a6adc8; vertical-alignment: center; width: 120px; }
                    LineEdit {
                        text: root.jvm-args;
                        placeholder-text: "-XX:+UseG1GC -XX:G1HeapRegionSize=16M";
                        edited(t) => { root.jvm-args = t; }
                    }
                }
            }

            Button {
                text: "Save Settings";
                clicked => {
                    root.save-requested(root.java-path, root.max-memory, root.jvm-args, 1100, 700);
                }
            }
        }
    }
}
