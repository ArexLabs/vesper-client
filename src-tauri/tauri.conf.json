{
  "productName": "Vesper Client",
  "version": "1.0.0",
  "identifier": "ai.vesper.client",
  "build": {
    "beforeDevCommand": "npm run dev:server",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"]
  },
  "app": {
    "windows": [
      {
        "title": "Vesper Client",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
