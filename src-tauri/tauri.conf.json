{
  "productName": "Vesper Client",
  "version": "1.0.0",
  "identifier": "ai.vesper.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "distDir": "../dist"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
      "icons": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "nsis": {
          "installMode": "both",
          "createDesktopShortcut": true,
          "createStartMenuShortcut": true
        },
        "msi": {
          "upgradeCode": "a1b2c3d4-e5f6-7890-abcd-123456789012"
        }
      },
      "macOS": {
        "minimumSystemVersion": "10.15",
        "dmg": {
          "window": {
            "position": "center",
            "size": {
              "width": 600,
              "height": 400
            }
          }
        }
      },
      "linux": {
        "deb": {
          "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libglib2.0-0"]
        }
      }
    },
    "commands": [{ "name": "create_instance" }, { "name": "microsoft_login" }],
    "windows": [
      {
        "title": "Vesper Client",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ],
    "allowlist": {
      "shell": {
        "open": true
      }
    }
  }
}
