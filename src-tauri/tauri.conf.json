{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper Client",
  "version": "1.0.0",
  "identifier": "de.devflare.launcher",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vesper Client",
        "decorations": false,
        "width": 1360,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
