# Microsoft Entra ID (Azure) — required for Microsoft account sign-in
# Register your app at https://portal.azure.com -> Microsoft Entra ID -> App registrations
# Supported account types: "Accounts in any organizational directory (Any Microsoft Entra ID tenant - Multitenant)
#   and personal Microsoft accounts (e.g. Skype, Xbox)"
# Authentication -> Advanced settings -> "Allow public client flows": Yes
# No redirect URI needed (Device Code Flow)
VESPER_AZURE_CLIENT_ID="replace-with-your-client-id"
