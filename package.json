{
  "name": "vesper-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:server": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/@biomejs/biome/bin/biome check .",
    "format": "node ./node_modules/@biomejs/biome/bin/biome format --write .",
    "test": "node ./node_modules/vitest/vitest.mjs",
    "test:run": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "codechecker": "node ./node_modules/knip/bin.js knip && node ./node_modules/cspell/cspell.js . --no-progress && npm run lint && npm run typecheck",
    "tauri:dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@modrinth/api-client": "^0.1.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/api": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "input-otp": "^1.4.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "react-resizable-panels": "^4.6.5",
    "react-router-dom": "^7.6.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-motion": "^1.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "cspell": "^10.0.0",
    "jsdom": "^25.0.1",
    "knip": "^6.12.1",
    "pnpm": "^11.0.8",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "8.0.10",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10",
    "bun": ">=1.1.0"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
